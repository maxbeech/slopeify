# Sentry (project slopeify_web in org maxed-labs). Set the DSNs in the Helm7 web service variables.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time only: source map upload. Never commit the token.
SENTRY_ORG=maxed-labs
SENTRY_PROJECT=slopeify_web
SENTRY_AUTH_TOKEN=

# Pro design report (Stripe). Checkout stays off until all three are set.
# Register https://<host>/api/stripe/webhook for checkout.session.completed and
# checkout.session.async_payment_succeeded, then copy that endpoint's signing secret here.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Emails the report to the buyer (lib/openhelm-mail.ts).
OPENHELM_API_KEY=
OPENHELM_MAIL_INBOX_ID=
